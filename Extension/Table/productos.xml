<?xml version="1.0" encoding="UTF-8"?>
<!--
    Personalización infometica: ocultar la variante base (sin color) del producto.
    Se marca a mano en la ficha del producto. NULL/0 = no ocultar. Solo tiene efecto si el
    producto tiene más de una variante.
-->
<table>
    <column>
        <name>ocultar_base</name>
        <type>boolean</type>
        <null>YES</null>
    </column>
</table>
