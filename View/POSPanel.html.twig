{% extends "Master/MenuBghTemplate.html.twig" %}

{% block body %}
    <div class="container-fluid d-print-none">
        <div class="row">
            <div class="col">
                <div class="card shadow mb-3">
                    <div class="card-body p-0">
                        <iframe id="posPanelFrame" src="{{ fsc.posUrl }}" title="{{ trans('point-of-sale') }}"
                                style="width: 100%; height: calc(100vh - 180px); min-height: 600px; border: 0;"
                                allow="fullscreen"></iframe>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
